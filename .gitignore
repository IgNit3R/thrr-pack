# 只上传四个文件夹的内容：ShanghaiAlice/、Tasofro/、trees/、tools/
# 另外保留根目录的 README.md、LICENSE 和 .gitignore 本身

/*
!/ShanghaiAlice/
!/Tasofro/
!/trees/
!/tools/
!/README.md
!/LICENSE
!/.gitignore

# 不上传 thbgm.dat 目录及其内容
thbgm.dat/

# 大型二进制/解包资源（不上传，仅保留结构占位）
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.webp
*.tga
*.dds
*.wav
*.mp3
*.ogg
*.mid
*.pos
*.anm
*.rpy
*.cv2
*.pat
*.msh
*.bmb
*.m3r
*.spv
*.otf
*.ttf
*.fnt
*.dll
*.exe
*.dat
*.pak
*.cga
*.cgb
Tasofro/**/unk_*

# 只忽略同名文件，不忽略同名目录（保留目录结构与 .gitkeep）
!*.dat/
!*.pak/
!*.cga/
!*.cgb/